# COOVI API — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env (it is gitignored).

# MongoDB Atlas connection string
MONGODB_URI=

# Server port (Render/Railway set this automatically in production)
PORT=5000

# development | production (production hides error details in API responses)
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API (CORS).
# Defaults to the local dev servers; production sets the real domains.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Flat delivery fee in BDT, applied server-side to every order (blank = 60)
DELIVERY_FEE=60

# Secret used to sign admin JWTs — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# First-boot admin credentials (seeded only when no admin exists; changing these later does NOT update an existing admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (free plan) stores the product photos uploaded from the admin panel.
# Copy all three from Cloudinary console → Settings → API Keys. Blank = photo upload is switched off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Number of reverse-proxy hops to trust so rate limits see real visitor IPs. Defaults to 1 in production and 0 elsewhere.
# TRUST_PROXY=1

# New-order email alerts through Resend (free plan; resend.com → API Keys). Blank = no alerts.
# NOTIFY_EMAIL_TO: where alerts go (comma-separated). Until the shop's domain is verified in Resend,
# it must be the email address you signed up to Resend with.
EMAIL_API_KEY=
NOTIFY_EMAIL_TO=
# Optional: sender once your domain is verified in Resend, e.g. Coovi Orders <orders@yourdomain>
# NOTIFY_EMAIL_FROM=
# Optional: admin panel address, used for the "Open the admin" link in alerts
# ADMIN_URL=https://coovi-admin.vercel.app

# Order confirmation SMS to the customer (order number, total, "we will call you").
# Blank = off. SMS_PROVIDER=alpha is Alpha SMS (sms.net.bd → API key in your dashboard).
SMS_PROVIDER=
SMS_API_KEY=
# Optional: approved sender name (masking); blank sends from the provider's normal number
# SMS_SENDER_ID=
# Optional: storefront address, adds a "Track:" link to the SMS
# STOREFRONT_URL=https://coovi-storefront.vercel.app
