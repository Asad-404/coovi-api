# COOVI API — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env (it is gitignored).

# MongoDB Atlas connection string
MONGODB_URI=

# Server port (Render/Railway set this automatically in production)
PORT=5000

# development | production (production hides error details in API responses)
NODE_ENV=development

# Flat delivery fee in BDT, applied server-side to every order (blank = 60)
DELIVERY_FEE=60

# Secret used to sign admin JWTs — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# First-boot admin credentials (seeded only when no admin exists; changing these later does NOT update an existing admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
