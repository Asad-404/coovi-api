# COOVI API — production environment variables
# Copy to .env.production on the server and fill in real values. Never commit .env.production.

# MongoDB connection string pointing at the coovi_mongo container on the internal Docker network.
# When self-hosting with docker-compose.yml, use this exact format:
#   mongodb://MONGO_USER:MONGO_PASS@coovi_mongo:27017/coovi?authSource=admin
# Replace MONGO_USER and MONGO_PASS with the values in your root .env.production.
MONGODB_URI=mongodb://coovi_user:CHANGE_ME@coovi_mongo:27017/coovi?authSource=admin

PORT=5000
NODE_ENV=production

# Allow requests from your real domains only (comma-separated, no trailing slash).
CORS_ORIGINS=https://coovi.com,https://www.coovi.com,https://admin.coovi.com

# Delivery fees in BDT.
DELIVERY_FEE_INSIDE_DHAKA=70
DELIVERY_FEE_OUTSIDE_DHAKA=130

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME

# Production admin login (seeded only when no admin exists; changing this after seeding has no effect).
ADMIN_EMAIL=admin@coovi.com
ADMIN_PASSWORD=CHANGE_ME

# Cloudinary — copy from Cloudinary console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Steadfast Courier — copy from the Steadfast merchant portal → API.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Same random value as STOREFRONT_API_KEY in coovi-storefront/.env.production.
# Generate with the same command as JWT_SECRET.
STOREFRONT_API_KEY=CHANGE_ME

# Number of reverse-proxy hops in front of the API.
# docker-compose + nginx = 1 (Nginx is the only proxy).
TRUST_PROXY=1

# Email alerts via Resend.
EMAIL_API_KEY=
NOTIFY_EMAIL_TO=
# NOTIFY_EMAIL_FROM=
# ADMIN_URL=https://admin.coovi.com
